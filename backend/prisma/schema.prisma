generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANT
// Representa uma clínica/empresa dentro do BHON.
// Cada clínica possui seus próprios usuários e dados.
// ============================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Tenant {
  id String @id @default(uuid())

  name      String
  tradeName String? @map("trade_name")
  slug      String  @unique

  email String
  phone String?

  status   TenantStatus @default(ACTIVE)
  planCode String       @default("STARTER") @map("plan_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  users           User[]
  patients        Patient[]
  treatments      Treatment[]
  quotes          Quote[]
  quoteItems      QuoteItem[]
  opportunities   Opportunity[]
  tasks           Task[]
  timelineEvents  TimelineEvent[]
  auditLogs       AuditLog[]
  sessions        Session[]

  @@index([status])
  @@index([createdAt])
  @@map("tenants")
}

// ============================================================
// USUÁRIO
// Pessoas que acessam o BHON dentro de uma clínica.
// ============================================================

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  DENTIST
  RECEPTIONIST
  FINANCIAL
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model User {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name  String
  email String

  // Email normalizado para evitar problemas de maiúsculas/minúsculas.
  // Exemplo:
  // Roberto@Email.com -> roberto@email.com
  emailNormalized String @map("email_normalized")

  // Pode ser nulo futuramente para permitir outros métodos de login.
  passwordHash String? @map("password_hash")

  role   UserRole   @default(RECEPTIONIST)
  status UserStatus @default(ACTIVE)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  sessions Session[]

  responsibleTreatments Treatment[] @relation("TreatmentResponsible")
  createdQuotes         Quote[]     @relation("QuoteCreator")
  assignedOpportunities Opportunity[] @relation("OpportunityAssignee")
  assignedTasks         Task[]         @relation("TaskAssignee")

  timelineEvents TimelineEvent[] @relation("TimelineActor")
  auditLogs      AuditLog[]      @relation("AuditActor")

  @@unique([tenantId, emailNormalized])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, role])
  @@map("users")
}

// ============================================================
// SESSÃO
// Estrutura para autenticação segura.
// O BHON nunca deve armazenar o token de sessão em texto puro.
// ============================================================

model Session {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String @map("user_id")

  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

// ============================================================
// PACIENTE
// Dados cadastrais e operacionais do paciente.
// ============================================================

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Patient {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name  String
  phone String?
  email String?

  birthDate DateTime? @map("birth_date") @db.Date

  status PatientStatus @default(ACTIVE)

  // Origem do paciente.
  // Exemplos:
  // Instagram, indicação, Google, WhatsApp, site etc.
  source String?

  externalRef String? @map("external_ref")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  treatments    Treatment[]
  quotes        Quote[]
  opportunities Opportunity[]
  tasks         Task[]
  timelineEvents TimelineEvent[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, externalRef])
  @@map("patients")
}

// ============================================================
// TRATAMENTO
// Representa um tratamento/procedimento acompanhado pelo BHON.
// ============================================================

enum TreatmentStatus {
  LEAD
  QUOTED
  PENDING
  SCHEDULED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
  ABANDONED
}

model Treatment {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  patientId String @map("patient_id")

  responsibleUserId String? @map("responsible_user_id")

  name        String
  description String?

  value Decimal? @db.Decimal(12, 2)

  status TreatmentStatus @default(PENDING)

  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  responsibleUser User? @relation(
    "TreatmentResponsible",
    fields: [responsibleUserId],
    references: [id],
    onDelete: SetNull
  )

  quoteItems QuoteItem[]

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, responsibleUserId])
  @@map("treatments")
}

// ============================================================
// ORÇAMENTO
// Cabeçalho de um orçamento comercial.
// ============================================================

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
  NO_RESPONSE
}

model Quote {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  patientId String @map("patient_id")

  createdById String? @map("created_by_id")

  status QuoteStatus @default(DRAFT)

  totalAmount Decimal @default(0) @map("total_amount") @db.Decimal(12, 2)

  sentAt     DateTime? @map("sent_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  createdBy User? @relation(
    "QuoteCreator",
    fields: [createdById],
    references: [id],
    onDelete: SetNull
  )

  items QuoteItem[]

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("quotes")
}

// ============================================================
// ITENS DO ORÇAMENTO
// Um orçamento pode possuir vários procedimentos.
// ============================================================

model QuoteItem {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  quoteId  String @map("quote_id")

  treatmentId String? @map("treatment_id")

  description String

  quantity Decimal @default(1) @db.Decimal(10, 2)

  unitPrice Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)

  totalPrice Decimal @default(0) @map("total_price") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  quote Quote @relation(
    fields: [quoteId],
    references: [id],
    onDelete: Cascade
  )

  treatment Treatment? @relation(
    fields: [treatmentId],
    references: [id],
    onDelete: SetNull
  )

  @@index([tenantId])
  @@index([tenantId, quoteId])
  @@index([tenantId, treatmentId])
  @@map("quote_items")
}

// ============================================================
// OPORTUNIDADE
// É aqui que entra uma das principais inteligências do BHON:
//
// "Quem precisa da minha atenção hoje?"
// ============================================================

enum OpportunityType {
  NO_RETURN
  MISSED_APPOINTMENT
  UNPAID_QUOTE
  ABANDONED_TREATMENT
  FOLLOW_UP
  REACTIVATION
}

enum OpportunityStatus {
  NEW
  IN_PROGRESS
  WAITING
  CONVERTED
  LOST
  DISMISSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Opportunity {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  patientId String @map("patient_id")

  assignedToId String? @map("assigned_to_id")

  type   OpportunityType
  status OpportunityStatus @default(NEW)
  priority Priority         @default(MEDIUM)

  reason String?

  estimatedValue Decimal? @map("estimated_value") @db.Decimal(12, 2)

  nextAction   String?   @map("next_action")
  nextActionAt DateTime? @map("next_action_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  assignedTo User? @relation(
    "OpportunityAssignee",
    fields: [assignedToId],
    references: [id],
    onDelete: SetNull
  )

  tasks Task[]

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, type])
  @@index([tenantId, nextActionAt])
  @@map("opportunities")
}

// ============================================================
// TAREFA
// Ação concreta que alguém precisa executar.
// ============================================================

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  patientId     String? @map("patient_id")
  opportunityId String? @map("opportunity_id")
  assignedToId  String? @map("assigned_to_id")

  title       String
  description String?

  priority Priority  @default(MEDIUM)
  status   TaskStatus @default(OPEN)

  dueAt       DateTime? @map("due_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  patient Patient? @relation(
    fields: [patientId],
    references: [id],
    onDelete: SetNull
  )

  opportunity Opportunity? @relation(
    fields: [opportunityId],
    references: [id],
    onDelete: SetNull
  )

  assignedTo User? @relation(
    "TaskAssignee",
    fields: [assignedToId],
    references: [id],
    onDelete: SetNull
  )

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, status])
  @@index([tenantId, dueAt])
  @@map("tasks")
}

// ============================================================
// TIMELINE
// Histórico operacional do relacionamento com o paciente.
//
// Exemplo:
// - paciente cadastrado
// - orçamento enviado
// - orçamento visualizado
// - ligação realizada
// - tarefa concluída
// - tratamento iniciado
// ============================================================

model TimelineEvent {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  patientId String @map("patient_id")

  actorUserId String? @map("actor_user_id")

  type        String
  description String?

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  patient Patient @relation(
    fields: [patientId],
    references: [id],
    onDelete: Restrict
  )

  actorUser User? @relation(
    "TimelineActor",
    fields: [actorUserId],
    references: [id],
    onDelete: SetNull
  )

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, createdAt])
  @@index([tenantId, type])
  @@map("timeline_events")
}

// ============================================================
// AUDITORIA
//
// Registro de ações importantes realizadas dentro do sistema.
//
// Exemplo:
// USER_UPDATED
// PATIENT_CREATED
// QUOTE_ACCEPTED
// PERMISSION_CHANGED
//
// Esse registro não é a mesma coisa que Timeline.
// Timeline é operacional.
// AuditLog é segurança/auditoria.
// ============================================================

model AuditLog {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  actorUserId String? @map("actor_user_id")

  action     String
  resource   String
  resourceId String? @map("resource_id")

  metadata Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  actorUser User? @relation(
    "AuditActor",
    fields: [actorUserId],
    references: [id],
    onDelete: SetNull
  )

  @@index([tenantId])
  @@index([tenantId, actorUserId])
  @@index([tenantId, action])
  @@index([tenantId, resource])
  @@index([tenantId, resourceId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
