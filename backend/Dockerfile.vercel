FROM node:24-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json prisma.config.ts tsconfig.json ./
COPY prisma ./prisma

# The repository lockfile is currently behind package.json (Google auth dependency).
# npm install reconciles the lockfile during the immutable build image instead of
# failing at npm ci before the backend can be compiled.
RUN npm install --include=dev

COPY src ./src
RUN npm run build

ENV NODE_ENV=production
ENV BHON_CONTAINER=1
ENV PORT=3000

EXPOSE 3000

CMD ["node", "dist/server.js"]
