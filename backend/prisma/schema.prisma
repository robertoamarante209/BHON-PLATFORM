generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// TENANT
// Representa uma clínica/empresa dentro do BHON.
// Cada clínica possui seus próprios usuários e dados.
// ============================================================

enum TenantStatus {
  ACTIVE
  TEST
  PAYMENT_PENDING
  SUSPENDED
  CANCELLED
}

model Tenant {
  id String @id @default(uuid())

  name      String
  tradeName String? @map("trade_name")
  slug      String  @unique

  email String
  phone String?

  status   TenantStatus @default(ACTIVE)
  planCode String       @default("STARTER") @map("plan_code")
  patientRecordSequence Int @default(0) @map("patient_record_sequence")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  users                 User[]
  rooms                 Room[]
  patients              Patient[]
  appointments          Appointment[]
  treatments            Treatment[]
  treatmentStages       TreatmentStage[]
  quotes                Quote[]
  quoteItems            QuoteItem[]
  opportunities         Opportunity[]
  tasks                 Task[]
  followUps             FollowUp[]
  payments              Payment[]
  financialTransactions FinancialTransaction[]
  timelineEvents        TimelineEvent[]
  auditLogs             AuditLog[]
  sessions              Session[]
  subscriptions         Subscription[]
  platformInvoices      PlatformInvoice[]
  supportTickets        SupportTicket[]
  notifications         Notification[]

  @@index([status])
  @@index([createdAt])
  @@map("tenants")
}

// ============================================================
// USUÁRIO
// Pessoas que acessam o BHON dentro de uma clínica ou na plataforma.
// ============================================================

enum UserRole {
  PLATFORM_OWNER
  OWNER
  ADMIN
  MANAGER
  DENTIST
  RECEPTIONIST
  FINANCIAL
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model User {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name  String
  email String

  emailNormalized String @map("email_normalized")
  passwordHash    String? @map("password_hash")

  role   UserRole   @default(RECEPTIONIST)
  status UserStatus @default(ACTIVE)

  specialty     String?
  cro           String?
  phone         String?
  avatarUrl     String?   @map("avatar_url")
  workloadHours Decimal?  @map("workload_hours") @db.Decimal(4, 2)
  currentRoomId String?   @map("current_room_id")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  sessions Session[]

  responsibleTreatments   Treatment[]     @relation("TreatmentResponsible")
  createdQuotes           Quote[]         @relation("QuoteCreator")
  assignedOpportunities   Opportunity[]   @relation("OpportunityAssignee")
  assignedTasks           Task[]          @relation("TaskAssignee")
  appointmentsAsDoctor    Appointment[]   @relation("AppointmentProfessional")
  assignedFollowUps       FollowUp[]      @relation("FollowUpAssignee")
  openedSupportTickets    SupportTicket[] @relation("SupportTicketAuthor")
  assignedSupportTickets  SupportTicket[] @relation("SupportTicketAssignee")
  notifications           Notification[]  @relation("NotificationRecipient")

  timelineEvents TimelineEvent[] @relation("TimelineActor")
  auditLogs      AuditLog[]      @relation("AuditActor")

  @@unique([tenantId, emailNormalized])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, role])
  @@map("users")
}

// ============================================================
// SESSÃO
// Autenticação segura por token criptográfico.
// ============================================================

model Session {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String @map("user_id")

  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

// ============================================================
// CONSULTÓRIO / SALA (ROOM)
// Consultório 01, Consultório 02, Consultório 03...
// ============================================================

model Room {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name        String
  orderIndex  Int     @default(1) @map("order_index")
  isActive    Boolean @default(true) @map("is_active")
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("rooms")
}

// ============================================================
// PACIENTE
// Dados cadastrais e operacionais do paciente.
// ============================================================

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Patient {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  recordNumber String  @map("record_number") // Ex: #03945
  name         String
  cpf          String?
  phone        String?
  email        String?
  birthDate    DateTime? @map("birth_date") @db.Date

  status       PatientStatus @default(ACTIVE)
  source       String?
  externalRef  String? @map("external_ref")
  allergies    String?
  observations String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  appointments   Appointment[]
  treatments     Treatment[]
  quotes         Quote[]
  opportunities  Opportunity[]
  tasks          Task[]
  followUps      FollowUp[]
  payments       Payment[]
  financialTransactions FinancialTransaction[]
  timelineEvents TimelineEvent[]

  @@unique([tenantId, recordNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, externalRef])
  @@map("patients")
}

// ============================================================
// TRATAMENTO
// Plano terapêutico contínuo do paciente.
// ============================================================

enum TreatmentStatus {
  LEAD
  QUOTED
  PENDING
  ACTIVE
  SCHEDULED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
  ABANDONED
  RISK_OF_ABANDONMENT
}

model Treatment {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  patientId String @map("patient_id")

  responsibleUserId String? @map("responsible_user_id")

  name        String
  description String?
  totalValue  Decimal? @map("total_value") @db.Decimal(12, 2)

  status          TreatmentStatus @default(ACTIVE)
  progressPercent Int             @default(0) @map("progress_percent")
  nextStageDate   DateTime?       @map("next_stage_date") @db.Timestamptz(3)

  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  responsibleUser User? @relation("TreatmentResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  stages       TreatmentStage[]
  appointments Appointment[]
  quoteItems   QuoteItem[]
  payments     Payment[]
  financialTransactions FinancialTransaction[]

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, responsibleUserId])
  @@map("treatments")
}

// ============================================================
// ETAPAS DO TRATAMENTO (TREATMENT STAGES)
// Sessão 1/3, 2/3, 3/3, etc.
// ============================================================

enum StageStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TreatmentStage {
  id          String @id @default(uuid())
  tenantId    String @map("tenant_id")
  treatmentId String @map("treatment_id")

  stageNumber Int         @default(1) @map("stage_number")
  title       String
  description String?
  status      StageStatus @default(PENDING)

  plannedDate   DateTime? @map("planned_date") @db.Timestamptz(3)
  completedDate DateTime? @map("completed_date") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  treatment    Treatment     @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId])
  @@index([tenantId, treatmentId])
  @@map("treatment_stages")
}

// ============================================================
// AGENDAMENTO (APPOINTMENT)
// A consulta na linha do tempo clínica e consultórios.
// ============================================================

enum AppointmentStatus {
  CONFIRMADO
  AGUARDANDO_CONFIRMACAO
  NA_RECEPCAO
  EM_ATENDIMENTO
  CONCLUIDO
  ATRASADO
  FALTA
  CANCELADO
  ENCAIXE
}

model Appointment {
  id               String @id @default(uuid())
  tenantId         String @map("tenant_id")
  patientId        String @map("patient_id")
  professionalId   String @map("professional_id")
  roomId           String @map("room_id")
  treatmentId      String? @map("treatment_id")
  treatmentStageId String? @map("treatment_stage_id")

  scheduledAt     DateTime          @map("scheduled_at") @db.Timestamptz(3)
  durationMinutes Int               @default(30) @map("duration_minutes")
  procedureName   String            @map("procedure_name")
  status          AppointmentStatus @default(CONFIRMADO)
  delayMinutes    Int               @default(0) @map("delay_minutes")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professional   User            @relation("AppointmentProfessional", fields: [professionalId], references: [id], onDelete: Restrict)
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  treatment      Treatment?      @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  treatmentStage TreatmentStage? @relation(fields: [treatmentStageId], references: [id], onDelete: SetNull)

  followUps FollowUp[]

  @@index([tenantId])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, roomId])
  @@index([tenantId, professionalId])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("appointments")
}

// ============================================================
// ORÇAMENTO (QUOTE / BUDGET)
// ============================================================

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
  NO_RESPONSE
}

model Quote {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  patientId String @map("patient_id")

  createdById String? @map("created_by_id")

  status QuoteStatus @default(DRAFT)

  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalAmount    Decimal   @default(0) @map("final_amount") @db.Decimal(12, 2)
  paymentMethod  String?   @map("payment_method")

  sentAt     DateTime? @map("sent_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  createdBy User? @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  items    QuoteItem[]
  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("quotes")
}

model QuoteItem {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  quoteId  String @map("quote_id")

  treatmentId String? @map("treatment_id")

  description String

  quantity   Decimal @default(1) @db.Decimal(10, 2)
  unitPrice  Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @default(0) @map("total_price") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  treatment Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, quoteId])
  @@index([tenantId, treatmentId])
  @@map("quote_items")
}

// ============================================================
// OPORTUNIDADES COMERCIAIS
// ============================================================

enum OpportunityType {
  NO_RETURN
  MISSED_APPOINTMENT
  UNPAID_QUOTE
  ABANDONED_TREATMENT
  FOLLOW_UP
  REACTIVATION
  NEW_CONTACT
}

enum OpportunityStatus {
  NEW_CONTACT
  TRIAGEM
  AVALIACAO
  PLANO_APRESENTADO
  ORCAMENTO
  NEGOCIACAO
  CONVERTIDO
  PERDIDO
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Opportunity {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  patientId String @map("patient_id")

  assignedToId String? @map("assigned_to_id")

  type     OpportunityType
  status   OpportunityStatus @default(TRIAGEM)
  priority Priority          @default(MEDIUM)

  source         String?
  potentialValue Decimal?  @map("potential_value") @db.Decimal(12, 2)
  daysInactive   Int       @default(0) @map("days_inactive")
  nextStep       String?   @map("next_step")
  lastContactAt  DateTime? @map("last_contact_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient  Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assignedTo User? @relation("OpportunityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  tasks Task[]

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, assignedToId])
  @@map("opportunities")
}

// ============================================================
// TAREFAS / FILA DE AÇÃO
// ============================================================

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  patientId     String? @map("patient_id")
  opportunityId String? @map("opportunity_id")
  assignedToId  String? @map("assigned_to_id")

  title       String
  description String?

  priority Priority   @default(MEDIUM)
  status   TaskStatus @default(OPEN)

  dueAt       DateTime? @map("due_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  assignedTo  User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, status])
  @@index([tenantId, dueAt])
  @@map("tasks")
}

// ============================================================
// ACOMPANHAMENTOS (FOLLOW-UPS)
// Filas operacionais de retorno, pós-operatório 48h, etc.
// ============================================================

enum FollowUpCategory {
  POS_OPERATORIO
  CONFIRMACAO
  RETORNO
  ORCAMENTO
  TRATAMENTO
  REATIVACAO
  PENDENCIA_CLINICA
}

enum FollowUpStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  ADIADO
  CANCELADO
}

model FollowUp {
  id            String @id @default(uuid())
  tenantId      String @map("tenant_id")
  patientId     String @map("patient_id")
  appointmentId String? @map("appointment_id")

  responsibleUserId String? @map("responsible_user_id")

  category      FollowUpCategory
  reason        String
  priority      Priority         @default(MEDIUM)
  status        FollowUpStatus   @default(PENDENTE)

  deadlineAt    DateTime  @map("deadline_at") @db.Timestamptz(3)
  lastContactAt DateTime? @map("last_contact_at") @db.Timestamptz(3)
  nextAction    String?   @map("next_action")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  responsibleUser User?        @relation("FollowUpAssignee", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, category])
  @@index([tenantId, status])
  @@index([tenantId, deadlineAt])
  @@map("follow_ups")
}

// ============================================================
// FINANCEIRO CLÍNICO: PAGAMENTOS E TRANSAÇÕES
// ============================================================

enum PaymentStatus {
  PAGO
  PENDENTE
  ATRASADO
  PARCIAL
  CANCELADO
}

enum TransactionType {
  RECEITA
  DESPESA
}

model Payment {
  id          String @id @default(uuid())
  tenantId    String @map("tenant_id")
  patientId   String @map("patient_id")
  quoteId     String? @map("quote_id")
  treatmentId String? @map("treatment_id")

  referenceType String  @default("TREATMENT") @map("reference_type")
  amount        Decimal @db.Decimal(12, 2)

  dueDate       DateTime      @map("due_date") @db.Date
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(3)
  paymentMethod String?       @map("payment_method")
  status        PaymentStatus @default(PENDENTE)
  notes         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  quote     Quote?     @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  treatment Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  financialTransaction FinancialTransaction?

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("payments")
}

model FinancialTransaction {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  paymentId   String? @unique @map("payment_id")
  patientId   String? @map("patient_id")
  treatmentId String? @map("treatment_id")

  type        TransactionType
  category    String
  description String
  amount      Decimal         @db.Decimal(12, 2)

  dueDate   DateTime      @map("due_date") @db.Date
  paidAt    DateTime?     @map("paid_at") @db.Timestamptz(3)
  status    PaymentStatus @default(PENDENTE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment   Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  patient   Patient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  treatment Treatment?  @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, patientId])
  @@index([tenantId, treatmentId])
  @@map("financial_transactions")
}

// ============================================================
// FATURAMENTO DA PLATAFORMA BHON (PLATFORM OWNER ENVIRONMENT)
// Cobrança das assinaturas que a BHON recebe das clínicas.
// ============================================================

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

model SubscriptionPlan {
  id               String  @id @default(uuid())
  name             String
  code             String  @unique
  maxProfessionals Int     @default(5) @map("max_professionals")
  maxRooms         Int     @default(3) @map("max_rooms")
  monthlyPrice     Decimal @map("monthly_price") @db.Decimal(10, 2)
  annualPrice      Decimal @map("annual_price") @db.Decimal(10, 2)
  featuresJson     Json?   @map("features_json")
  isActive         Boolean @default(true) @map("is_active")

  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  planId   String @map("plan_id")

  status       SubscriptionStatus @default(ACTIVE)
  billingCycle BillingCycle       @default(MONTHLY) @map("billing_cycle")

  currentPeriodStart DateTime @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime @map("current_period_end") @db.Timestamptz(3)
  renewalDate        DateTime @map("renewal_date") @db.Timestamptz(3)
  amount             Decimal  @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices PlatformInvoice[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model PlatformInvoice {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  subscriptionId String @map("subscription_id")

  invoiceNumber String        @unique @map("invoice_number")
  amount        Decimal       @db.Decimal(10, 2)
  dueDate       DateTime      @map("due_date") @db.Date
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(3)
  status        PaymentStatus @default(PENDENTE)
  paymentMethod String?       @map("payment_method")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payments     PlatformPayment[]

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@map("platform_invoices")
}

model PlatformPayment {
  id                String @id @default(uuid())
  platformInvoiceId String @map("platform_invoice_id")

  amount     Decimal   @db.Decimal(10, 2)
  paidAt     DateTime  @default(now()) @map("paid_at") @db.Timestamptz(3)
  status     String    @default("CONFIRMED")
  gatewayRef String?   @map("gateway_ref")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice PlatformInvoice @relation(fields: [platformInvoiceId], references: [id], onDelete: Cascade)

  @@index([platformInvoiceId])
  @@map("platform_payments")
}

// ============================================================
// SUPORTE TÉCNICO DA PLATAFORMA (SUPPORT TICKETS)
// ============================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
}

model SupportTicket {
  id              String @id @default(uuid())
  tenantId        String @map("tenant_id")
  openedByUserId  String @map("opened_by_user_id")
  assignedToUserId String? @map("assigned_to_id")

  title       String
  description String
  priority    Priority     @default(MEDIUM)
  status      TicketStatus @default(OPEN)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  openedByUser   User   @relation("SupportTicketAuthor", fields: [openedByUserId], references: [id], onDelete: Restrict)
  assignedToUser User?  @relation("SupportTicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

// ============================================================
// NOTIFICAÇÕES OPERACIONAIS (NOTIFICATIONS)
// ============================================================

model Notification {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String @map("user_id")

  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  priority  Priority @default(MEDIUM)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, read])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// TIMELINE OPERACIONAL E AUDITORIA
// ============================================================

model TimelineEvent {
  id String @id @default(uuid())

  tenantId    String @map("tenant_id")
  patientId   String @map("patient_id")
  actorUserId String? @map("actor_user_id")

  type        String
  description String?
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  actorUser User? @relation("TimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, createdAt])
  @@index([tenantId, type])
  @@map("timeline_events")
}

model AuditLog {
  id String @id @default(uuid())

  tenantId    String @map("tenant_id")
  actorUserId String? @map("actor_user_id")

  action     String
  resource   String
  resourceId String? @map("resource_id")
  metadata   Json?
  userAgent  String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUser User?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, actorUserId])
  @@index([tenantId, action])
  @@index([tenantId, resource])
  @@index([tenantId, resourceId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
